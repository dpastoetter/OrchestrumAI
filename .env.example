# --- AI providers (see Settings in UI or /api/providers) ---

# Google Gemini (native ADK — recommended default)
GOOGLE_API_KEY=

# OpenAI
# OPENAI_API_KEY=

# Anthropic Claude
# ANTHROPIC_API_KEY=

# OpenRouter (many models, one key)
# OPENROUTER_API_KEY=

# Local Ollama
OLLAMA_HOST=http://127.0.0.1:11434

# LM Studio (OpenAI-compatible)
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1

# ChatGPT Plus/Pro OAuth: connect in Settings (requires pip install 'orchestrumai[llm]')

# Optional legacy override
# ADK_DEFAULT_MODEL=gemini-2.5-flash

# Backend
ORCHESTRUMAI_HOST=127.0.0.1
ORCHESTRUMAI_PORT=8000
ORCHESTRUMAI_DATA_DIR=./data
# Required when binding outside loopback (e.g. 0.0.0.0). Also set VITE_ORCHESTRUMAI_API_TOKEN for the UI.
# ORCHESTRUMAI_API_TOKEN=
# Comma-separated browser origins allowed to call the API (defaults cover local Vite + backend).
# ORCHESTRUMAI_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Set to 1 to simulate agents without calling Gemini
# ORCHESTRUMAI_STUB_RUN=1

# Google Sheets (service account JSON path + default spreadsheet)
GOOGLE_APPLICATION_CREDENTIALS=
DEFAULT_SPREADSHEET_ID=
# Set to 0 to force stub/mock writes even with credentials
# SHEETS_WRITE_ENABLED=0
